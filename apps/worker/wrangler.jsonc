{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-07-27",
  "compatibility_flags": ["nodejs_compat_v2", "enable_ctx_exports"],
  "rules": [
    {
      "type": "Data",
      "globs": ["**/*.tgz"],
      "fallthrough": false,
    },
  ],
  "d1_databases": [
    {
      "binding": "DATABASE",
      "database_name": "crazp-db",
      "database_id": "d7785a65-1aaa-455c-a4e8-25b4096e6830",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "AGENT_DEPLOYMENT_BUCKET",
      "bucket_name": "crazp-agent-deployments-dev",
      "remote": true,
    },
  ],
  "queues": {
    "consumers": [
      {
        "queue": "crazp-agent-deployments",
        "max_batch_size": 1,
      },
    ],
  },
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      // DinD + nested cloudflare/sandbox image builds need more than lite (256 MiB / 2 GB).
      "instance_type": "standard-2",
      "max_instances": 3,
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "Sandbox",
        "name": "SANDBOX",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Sandbox"],
    },
  ],
}
