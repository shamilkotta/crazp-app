{
  "name": "crazp-app",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "oxfmt .",
    "typecheck": "turbo typecheck",
    "vendor:crazp": "node scripts/vendor-crazp-core.mjs",
    "db:generate": "pnpm --filter @workspace/db db:generate",
    "db:migrate:local": "pnpm --filter dashboard db:migrate:local",
    "db:studio": "pnpm --filter @workspace/db db:studio",
    "auth:generate": "pnpm --filter dashboard auth:generate"
  },
  "devDependencies": {
    "@workspace/oxlint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "turbo": "^2.9.18",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "crazp": "file:../crazp/packages/crazp"
    }
  }
}
